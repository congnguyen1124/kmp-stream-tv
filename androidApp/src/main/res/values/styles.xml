<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KmpStreamTv" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/stream_background</item>
        <item name="android:colorAccent">@color/stream_accent</item>
        <item name="android:navigationBarColor">@color/stream_background</item>
        <item name="android:statusBarColor">@color/stream_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/stream_accent</item>
        <item name="colorPrimaryVariant">@color/stream_accent</item>
        <item name="colorOnPrimary">@color/stream_text</item>
        <item name="colorSecondary">@color/stream_accent</item>
        <item name="colorOnSurface">@color/stream_text</item>
    </style>

    <style name="Widget.StreamTV.TopBarButton" parent="@android:style/Widget.ImageButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/nav_item_background</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">@color/stream_text</item>
    </style>

    <style name="Widget.StreamTV.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/stream_accent</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.StreamTV.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/stream_accent_soft</item>
    </style>

    <style name="ShapeAppearance.StreamTV.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.StreamTV.Story" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.StreamTV.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.StreamTV.MiniApp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">13dp</item>
    </style>
</resources>
