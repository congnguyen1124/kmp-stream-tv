<?xml version="1.0" encoding="utf-8"?><!--
  The overlay hierarchy of NewMinimizableView in ottclouds-android:

    minimizableView       Box(fillMaxSize)
    ├── detailContent     bottomContent, faded out by bottomContentAlpha
    └── playerCard        the Column: width fraction, edge padding, offset, top-end gravity
        └── playerCardContent   what graphicsLayer { scale } scales, clips and shadows
            ├── playerSurface   the 16:9 video Box
            └── miniPlaybackController   footerContent

  detailContent reserves the player's 16:9 strip with playerStrip instead of laying the player out
  inside it, because the player is a sibling that floats over this content and travels away from it.
-->
<com.congnguyencn.kmpstreamtv.feature.player.miniplayer.MinimizableView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/minimizableView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detailContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/appBackground">

        <Space
            android:id="@+id/playerStrip"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/detailShadow"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/player_detail_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playerStrip" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/detailList"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/margin_4x"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailShadow" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
      clipChildren/clipToPadding are off all the way down to playerCardContent: a pinched-open card
      paints past the box it measures, and a clipping ancestor would crop exactly that overflow.
    -->
    <FrameLayout
        android:id="@+id/playerCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/playerCardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.congnguyencn.kmpstreamtv.feature.player.miniplayer.AspectRatioFrameLayout
                android:id="@+id/playerSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black">

                <com.congnguyencn.kmpstreamtv.feature.player.widget.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.congnguyencn.kmpstreamtv.feature.player.miniplayer.AspectRatioFrameLayout>

            <com.congnguyencn.kmpstreamtv.feature.player.widget.MiniPlaybackControllerView
                android:id="@+id/miniPlaybackController"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mini_player_footer_height" />
        </LinearLayout>
    </FrameLayout>
</com.congnguyencn.kmpstreamtv.feature.player.miniplayer.MinimizableView>
