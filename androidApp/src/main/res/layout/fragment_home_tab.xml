<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainerHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/topBarScrim"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:alpha="0.32"
        android:background="@drawable/topbar_gradient" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_edge"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="128dp"
                android:layout_height="44dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/img_logo_app" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/search"
                style="@style/Widget.StreamTV.TopBarButton"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageButton
                    android:id="@+id/notifications"
                    style="@style/Widget.StreamTV.TopBarButton"
                    android:contentDescription="@string/notifications"
                    android:src="@drawable/ic_notifications" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/notification_dot" />
            </FrameLayout>

            <TextView
                android:id="@+id/profile"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/profile_background"
                android:contentDescription="@string/profile"
                android:gravity="center"
                android:text="@string/stream_initial"
                android:textColor="@color/stream_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.congnguyencn.kmpstreamtv.feature.home.HomeCategoriesBar
            android:id="@+id/categories"
            android:layout_width="match_parent"
            android:layout_height="51dp" />

        <View
            android:id="@+id/topBarDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stream_divider"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
