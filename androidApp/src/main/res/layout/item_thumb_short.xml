<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="@dimen/margin_small_x">

    <com.congnguyencn.kmpstreamtv.feature.home.widget.ImageAnimationView
        android:id="@+id/ivShortThumbnail"
        android:layout_width="@dimen/short_thumbnail_width"
        android:layout_height="@dimen/short_thumbnail_height"
        android:layout_marginEnd="@dimen/horizontal_list_divider"
        android:background="@drawable/image_placeholder_rounded"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/GenericThumbnail" />

    <TextView
        android:id="@+id/tvShortNumView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_tiny"
        android:drawablePadding="@dimen/margin_tiny"
        android:textAppearance="@style/Text.Heading2"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_play_circle"
        app:layout_constraintBottom_toBottomOf="@id/ivShortThumbnail"
        app:layout_constraintStart_toStartOf="@id/ivShortThumbnail" />
</androidx.constraintlayout.widget.ConstraintLayout>
