<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivCarouselBlur"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0.8"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_carousel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/carouselView" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_carousel_top"
        app:layout_constraintBottom_toTopOf="@id/carouselView"
        app:layout_constraintTop_toTopOf="parent" />

    <com.congnguyencn.kmpstreamtv.feature.home.widget.CarouseView
        android:id="@+id/carouselView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/home_content_padding_top"
        android:minHeight="@dimen/highlight_tall_thumbnail_height"
        app:layout_constraintTop_toTopOf="parent"
        app:thumbHeight="@dimen/highlight_tall_thumbnail_height"
        app:thumbWidth="@dimen/highlight_tall_thumbnail_width" />

    <Button
        android:id="@+id/btnWatchLater"
        style="@style/Button.Icon.Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4x"
        android:text="@string/watch_later"
        android:textSize="@dimen/sp_12"
        app:icon="@drawable/ic_follow_playlist"
        app:iconGravity="textTop"
        app:iconPadding="@dimen/margin_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/carouselView" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlay"
        style="@style/Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_x"
        android:layout_marginStart="@dimen/margin_tiny"
        android:layout_marginEnd="@dimen/margin_tiny"
        android:paddingVertical="0dp"
        android:text="@string/watch_now"
        app:cornerRadius="@dimen/button_radius"
        app:icon="@drawable/ic_play_round"
        app:iconGravity="textStart"
        app:iconSize="@dimen/icon_button_size_x"
        app:layout_constraintBottom_toBottomOf="@id/btnWatchLater"
        app:layout_constraintEnd_toStartOf="@id/btnInfo"
        app:layout_constraintStart_toEndOf="@id/btnWatchLater"
        app:layout_constraintTop_toTopOf="@id/btnWatchLater" />

    <View
        android:id="@+id/viewClick"
        style="@style/Button.Primary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/btnPlay"
        app:layout_constraintEnd_toStartOf="@id/btnPlay"
        app:layout_constraintStart_toEndOf="@id/btnPlay"
        app:layout_constraintTop_toTopOf="@id/btnPlay" />

    <Button
        android:id="@+id/btnInfo"
        style="@style/Button.Icon.Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/information"
        android:textSize="@dimen/sp_12"
        app:icon="@drawable/ic_info_circle"
        app:iconGravity="textTop"
        app:iconPadding="@dimen/margin_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnWatchLater" />

    <View
        android:id="@+id/viewSpaceBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_x"
        app:layout_constraintTop_toBottomOf="@id/btnWatchLater" />

    <FrameLayout
        android:id="@+id/pbLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/appBackground"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/carouselView">

        <ProgressBar
            style="@style/ContentLoading"
            android:layout_gravity="center" />
    </FrameLayout>

    <com.congnguyencn.kmpstreamtv.feature.home.widget.LayoutErrorView
        android:id="@+id/errorView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/appBackground"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/carouselView" />
</androidx.constraintlayout.widget.ConstraintLayout>
