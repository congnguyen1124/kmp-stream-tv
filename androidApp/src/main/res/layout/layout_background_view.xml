<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivLayoutBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutTitle"
        android:layout_width="@dimen/top_ten_title_width"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="@dimen/content_padding_horizontal"
        android:paddingStart="@dimen/margin_xx"
        android:paddingEnd="@dimen/margin_small_xx"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/ivLayoutIcon"
            android:layout_width="@dimen/icon_button_size_x"
            android:layout_height="@dimen/icon_button_size_x"
            android:contentDescription="@null" />

        <View
            android:id="@+id/viewDivider"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/margin_small_x" />

        <TextView
            android:id="@+id/tvLayoutTitle"
            style="@style/Text.Title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin"
        android:clipToPadding="false"
        android:paddingStart="@dimen/top_ten_title_width"
        android:paddingEnd="@dimen/content_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/pbLoading"
        style="@style/ContentLoading"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/layoutTitle"
        app:layout_constraintTop_toTopOf="parent" />

    <com.congnguyencn.kmpstreamtv.feature.home.widget.LayoutErrorView
        android:id="@+id/errorView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/layoutTitle"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
