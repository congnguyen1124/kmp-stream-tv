<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/margin_tiny"
    tools:layout_width="@dimen/mini_app_max_width">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAppIcon"
        android:layout_width="@dimen/mini_app_icon_size"
        android:layout_height="@dimen/mini_app_icon_size"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/LogoAppStyle"
        tools:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxWidth="@dimen/mini_app_max_width"
        android:maxLines="2"
        android:textAppearance="@style/Text.Caption3"
        android:textColor="@color/silverChalice"
        tools:text="StreamTV Originals" />
</LinearLayout>
