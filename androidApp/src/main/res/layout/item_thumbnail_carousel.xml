<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivThumbnailCarousel"
        android:layout_width="@dimen/highlight_tall_thumbnail_width"
        android:layout_height="@dimen/highlight_tall_thumbnail_height"
        android:background="@drawable/image_placeholder_vertical_large"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/GenericThumbnail" />

    <TextView
        android:id="@+id/tvSaymee"
        style="@style/SaymeeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_tiny_x"
        android:background="@drawable/bg_tag_saymee"
        android:text="@string/exclusive_label"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="@id/ivThumbnailCarousel"
        app:layout_constraintTop_toTopOf="@id/ivThumbnailCarousel"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
