<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/margin_small">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_story_thumbnail"
        android:layout_width="@dimen/story_thumbnail_width"
        android:layout_height="@dimen/story_thumbnail_height"
        android:background="@drawable/image_placeholder_rounded"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/StoryThumbnail" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_story_provider"
        android:layout_width="@dimen/provider_logo_size"
        android:layout_height="@dimen/provider_logo_size"
        android:layout_margin="@dimen/margin_small"
        android:background="@drawable/image_placeholder_provider"
        android:padding="@dimen/divider"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/CircularImage"
        app:strokeColor="@color/black"
        app:strokeWidth="@dimen/divider" />
</FrameLayout>
