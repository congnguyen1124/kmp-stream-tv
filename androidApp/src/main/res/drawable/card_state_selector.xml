<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/stream_accent" />
            <solid android:color="@color/stream_surface" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/stream_text" />
            <solid android:color="@color/stream_surface" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/transparent" />
            <solid android:color="@color/stream_surface" />
        </shape>
    </item>
</selector>
