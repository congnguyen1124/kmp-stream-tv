<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#662C2C2E" />
            <stroke android:width="1dp" android:color="@color/white_40" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:endColor="@color/purpleHeart"
                android:startColor="@color/heliotrope" />
        </shape>
    </item>
</selector>
