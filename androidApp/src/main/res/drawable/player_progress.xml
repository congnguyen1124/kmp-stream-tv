<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <size android:height="@dimen/player_progress_height" />
            <solid android:color="@color/playerProgressBackground" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical|fill_horizontal">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <size android:height="@dimen/player_progress_height" />
                <solid android:color="@color/playerSecondary" />
            </shape>
        </scale>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <size android:height="@dimen/player_progress_height" />
                <solid android:color="@color/playerPrimary" />
            </shape>
        </scale>
    </item>
</layer-list>
